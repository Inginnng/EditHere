{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:edithere:video-feedback:1",
  "title": "EditHere timestamped video feedback v1",
  "description": "Each frame.feedback is independently readable existing EditHere minimal feedback. Its image is embedded once per frame. The root objects array is a chronological annotation index: use frameId to find the screenshot and timestampMs to locate the video. Coordinates use original video-frame pixels; source is null for whole-frame feedback. Only annotated frames are exported; timestamps are relative to video start, timestampMs=floor(timestampUs/1000).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tool", "exportedAt", "video", "frames", "objects"],
  "properties": {
    "schemaVersion": {"const": "video-feedback-1"},
    "tool": {"const": "EditHere"},
    "exportedAt": {"type": "string", "format": "date-time"},
    "video": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "durationMs", "width", "height"],
      "properties": {
        "source": {"type": "string", "minLength": 1, "maxLength": 32768, "pattern": "\\S"},
        "durationMs": {"type": "integer", "minimum": 0, "maximum": 9007199254740},
        "width": {"type": "integer", "minimum": 0, "maximum": 32767},
        "height": {"type": "integer", "minimum": 0, "maximum": 32767}
      }
    },
    "frames": {
      "type": "array", "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "timestampMs", "timestampUs", "imageFile", "feedback"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\\\/:*?\"<>|\\u0000-\\u001f]+$"},
          "timestampMs": {"type": "integer", "minimum": 0, "maximum": 9007199254740},
          "timestampUs": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
          "imageFile": {"type": "string", "pattern": "^frame-[^\\\\/:*?\"<>|\\u0000-\\u001f]+\\.png$"},
          "feedback": {"$ref": "feedback-minimal.schema.json#/$defs/objectFormat"}
        }
      }
    },
    "objects": {
      "type": "array", "maxItems": 10000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["timestampMs", "frameId", "source", "movements", "annotations"],
        "properties": {
          "timestampMs": {"type": "integer", "minimum": 0, "maximum": 9007199254740},
          "frameId": {"type": "string", "minLength": 1},
          "source": {"oneOf": [{"type": "null"}, {"$ref": "feedback-minimal.schema.json#/$defs/rectangle"}]},
          "movements": {
            "type": "array", "maxItems": 8704,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["to"],
              "properties": {"to": {"$ref": "feedback-minimal.schema.json#/$defs/rectangle"}}
            }
          },
          "annotations": {"type": "array", "items": {"$ref": "feedback-minimal.schema.json#/$defs/text"}}
        }
      }
    }
  }
}
