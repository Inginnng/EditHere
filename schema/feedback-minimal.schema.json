{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HelpDesign minimal design feedback",
  "description": "Coordinates use original-image pixels with a top-left origin. Rectangle x2/y2 are exclusive. Changes contain only net position or size changes; apply all source cuts first, then draw changes in array order over the unchanged background.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "annotations",
    "changes"
  ],
  "properties": {
    "annotations": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "point",
              "text"
            ],
            "properties": {
              "point": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "x",
                  "y"
                ],
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 32766
                  },
                  "y": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 32766
                  }
                }
              },
              "text": {
                "$ref": "#/$defs/text"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rectangle",
              "text"
            ],
            "properties": {
              "rectangle": {
                "$ref": "#/$defs/annotationRectangle"
              },
              "text": {
                "$ref": "#/$defs/text"
              }
            }
          }
        ]
      }
    },
    "changes": {
      "type": "array",
      "maxItems": 8192,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "$ref": "#/$defs/rectangle"
          },
          "to": {
            "$ref": "#/$defs/rectangle"
          }
        }
      }
    }
  },
  "$defs": {
    "rectangle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x1",
        "y1",
        "x2",
        "y2"
      ],
      "properties": {
        "x1": {
          "type": "number",
          "minimum": 0,
          "maximum": 32767
        },
        "y1": {
          "type": "number",
          "minimum": 0,
          "maximum": 32767
        },
        "x2": {
          "type": "number",
          "minimum": 0,
          "maximum": 32767
        },
        "y2": {
          "type": "number",
          "minimum": 0,
          "maximum": 32767
        }
      }
    },
    "annotationRectangle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x1",
        "y1",
        "x2",
        "y2"
      ],
      "properties": {
        "x1": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32767
        },
        "y1": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32767
        },
        "x2": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32767
        },
        "y2": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32767
        }
      }
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000,
      "pattern": "\\S"
    }
  }
}
