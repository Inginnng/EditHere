{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:edithere:video-project:1",
  "title": "EditHere editable video project v1",
  "description": "The source video is referenced by address. Only annotated frames are stored, in ascending timestampUs order. Each frame contains one lossless editable image project. The application additionally checks unique frame IDs/timestamps, matching timestampMs=floor(timestampUs/1000), duration bounds, consistent dimensions, 128 million cumulative pixels, 10000 total notes/movements and a 512 MiB file limit.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tool", "exportedAt", "video", "frames"],
  "properties": {
    "schemaVersion": {"const": "video-project-1"},
    "tool": {"const": "EditHere"},
    "exportedAt": {"type": "string", "format": "date-time"},
    "video": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "durationMs", "positionMs"],
      "properties": {
        "source": {"type": "string", "minLength": 1, "maxLength": 32768, "pattern": "\\S"},
        "durationMs": {"type": "integer", "minimum": 0, "maximum": 9007199254740},
        "positionMs": {"type": "integer", "minimum": 0, "maximum": 9007199254740}
      }
    },
    "frames": {
      "type": "array", "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "timestampMs", "timestampUs", "document"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\\\/:*?\"<>|\\u0000-\\u001f]+$"},
          "timestampMs": {"type": "integer", "minimum": 0, "maximum": 9007199254740},
          "timestampUs": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
          "document": {
            "allOf": [
              {"$ref": "project-v3.schema.json"},
              {"properties": {"capture": {"properties": {"pngBase64": {"type": "string", "minLength": 1, "maxLength": 67108864}}}}}
            ]
          }
        }
      }
    }
  }
}
