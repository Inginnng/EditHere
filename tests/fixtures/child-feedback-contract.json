    },
    {
      "name": "independently-moved-child-is-top-level",
      "document": {
        "width": 800, "height": 600,
        "movements": [
          {"source": {"x1": 100, "y1": 100, "x2": 300, "y2": 200}, "destination": {"x1": 200, "y1": 140, "x2": 400, "y2": 240}},
