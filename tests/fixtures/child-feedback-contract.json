        {"id": "o2", "kind": "region", "source": {"x1": 440, "y1": 100, "x2": 500, "y2": 160}, "movement": {"rect": {"x1": 450, "y1": 110, "x2": 510, "y2": 170}, "dx": 10, "dy": 10}, "annotations": [{"number": 2, "text": "Independent movement"}]}
      ], "serializedObjects": "{\"objects\":[{\"annotations\":[{\"number\":1,\"text\":\"Parent movement\"}],\"id\":\"o1\",\"kind\":\"region\",\"movement\":{\"dx\":100,\"dy\":40,\"rect\":{\"x1\":200,\"x2\":400,\"y1\":140,\"y2\":240}},\"source\":{\"x1\":100,\"x2\":300,\"y1\":100,\"y2\":200}},{\"annotations\":[{\"number\":2,\"text\":\"Independent movement\"}],\"id\":\"o2\",\"kind\":\"region\",\"movement\":{\"dx\":10,\"dy\":10,\"rect\":{\"x1\":450,\"x2\":510,\"y1\":110,\"y2\":170}},\"source\":{\"x1\":440,\"x2\":500,\"y1\":100,\"y2\":160}}]}\n"}
    }
