      "expected": {"objects": [
        {"id": "o1", "kind": "region", "source": {"x1": 100, "y1": 100, "x2": 300, "y2": 200}, "annotations": [{"number": 1, "text": "Fill vacated area"}]},
        {"id": "o2", "kind": "region", "source": {"x1": 100, "y1": 100, "x2": 300, "y2": 200}, "movement": {"rect": {"x1": 200, "y1": 140, "x2": 400, "y2": 240}, "dx": 100, "dy": 40}, "annotations": [{"number": 2, "text": "Moved component"}], "children": [
          {"id": "o3", "kind": "region", "source": {"x1": 220, "y1": 150, "x2": 240, "y2": 170}, "annotations": [{"number": 3, "text": "Child"}]}
        ]}
      ], "serializedObjects": "{\"objects\":[{\"annotations\":[{\"number\":1,\"text\":\"Fill vacated area\"}],\"id\":\"o1\",\"kind\":\"region\",\"source\":{\"x1\":100,\"x2\":300,\"y1\":100,\"y2\":200}},{\"annotations\":[{\"number\":2,\"text\":\"Moved component\"}],\"id\":\"o2\",\"kind\":\"region\",\"movement\":{\"dx\":100,\"dy\":40,\"rect\":{\"x1\":200,\"x2\":400,\"y1\":140,\"y2\":240}},\"source\":{\"x1\":100,\"x2\":300,\"y1\":100,\"y2\":200},\"children\":[{\"annotations\":[{\"number\":3,\"text\":\"Child\"}],\"id\":\"o3\",\"kind\":\"region\",\"source\":{\"x1\":220,\"x2\":240,\"y1\":150,\"y2\":170}}]}]}\n"}
    },
    {
