          {"source": {"x1": 450, "y1": 110, "x2": 510, "y2": 170}, "movementSource": {"x1": 440, "y1": 100, "x2": 500, "y2": 160}, "text": "Independent movement", "parent": {"source": {"x1": 100, "y1": 100, "x2": 300, "y2": 200}, "state": "child"}}
        ]
